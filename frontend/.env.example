# Yjs collaboration hub. Unset = collaboration off; the editor works exactly as before.
# Self-hosted:  ws://localhost:1234  (see collab/server.js)
# Managed:      the provider's websocket endpoint
VITE_COLLAB_URL=

# Firebase (optional locally — unset runs the backend's in-memory dev mode)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
